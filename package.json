{
  "name": "fami",
  "version": "2.0.0",
  "main": "dist/main.js",
  "author": "dannycreations",
  "license": "GPL",
  "private": true,
  "scripts": {
    "start:watch": "npm run clean && tsx watch src/main.ts",
    "start:debug": "npm run build && node --inspect-brk .",
    "build": "npm run clean && tsc",
    "check": "npm run format && tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rimraf -g \"*.tsbuildinfo\" \"dist\"",
    "clean:node": "rimraf -g \"*-lock*\" \"node_modules\"",
    "update": "npm-check-updates -u -x got,@types/node",
    "prepare": "husky && effect-tsgo patch"
  },
  "dependencies": {
    "@vegapunk/utilities": "^1.0.79",
    "dotenv": "^17.4.2",
    "effect": "^3.21.4",
    "got": "11.8.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.50.2",
    "user-agents": "^2.1.119"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.19.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@sapphire/ts-config": "^5.0.3",
    "@types/node": "24.x",
    "@types/steam-totp": "^2.1.2",
    "@types/steam-user": "^5.1.1",
    "@types/steamcommunity": "^3.50.0",
    "@types/user-agents": "^1.0.4",
    "husky": "^9.1.7",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.12.0"
}
