{
  "name": "fami",
  "version": "1.0.0",
  "main": "dist/src-effect/main.js",
  "author": "dannycreations",
  "license": "GPL",
  "private": true,
  "scripts": {
    "start:watch": "npm run clean && tsx watch src-effect/main.ts",
    "start:debug": "npm run build && node --inspect-brk .",
    "build": "npm run clean && tsc",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rimraf -g \"*.tsbuildinfo\" \"dist\"",
    "clean:node": "rimraf -g \"*-lock*\" \"node_modules\"",
    "update": "npm-check-updates -u -x @octokit/rest,@types/node",
    "prepare": "husky"
  },
  "dependencies": {
    "@vegapunk/core": "^1.0.55",
    "@vegapunk/request": "^1.0.44",
    "@vegapunk/struct": "^1.0.17",
    "@vegapunk/utilities": "^1.0.78",
    "dotenv": "^17.2.3",
    "effect": "^3.19.14",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0",
    "steamcommunity": "^3.49.0",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@sapphire/ts-config": "^5.0.3",
    "@types/node": "22.x",
    "@types/steam-totp": "^2.1.2",
    "@types/steam-user": "^5.1.1",
    "@types/steamcommunity": "^3.43.8",
    "husky": "^9.1.7",
    "npm-check-updates": "^19.2.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@10.27.0"
}
